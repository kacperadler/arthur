%% Core and plugins. Green = first version, grey dashed = later. Plugins talk to the core, never to each other.
%% Arthur exposes nothing to the internet: every arrow out of a plugin is a call it makes, or a local process;
%% other machines are reached over SSH on a private network (Tailscale).
flowchart TD
  human([Human])

  subgraph CH[Channels and terminal]
    terminal[terminal<br/>arthur attach]
    telegram[telegram]
    whatsapp[whatsapp<br/>local bridge]
    signal[signal<br/>signal-cli]
    discord[discord<br/>gateway, outbound<br/>text built, media planned]
    slack[slack<br/>Socket Mode, outbound]
    terminal ~~~ telegram ~~~ signal ~~~ discord ~~~ slack ~~~ whatsapp
  end
  subgraph MEDIA[Media]
    listen[listen<br/>whisper.cpp, on the CPU<br/>listen.transcribe]
    video[video<br/>ffmpeg: frames, sound track]
    listen ~~~ video
  end

  subgraph CORE[Arthur core - always on]
    loader[config loader]
    host[plugin host<br/>command registry]
    runner[job runner<br/>worktree, log, stop<br/>state: working, idle,<br/>blocked, ended<br/>here or over SSH<br/>cleanup hooks on removal]
    board[ticket board]
    events[event stream]
    clock[clock<br/>time zone, quiet hours]
    guards[env guard<br/>worktree guard<br/>job sandbox]
    kit[test kit<br/>fake host, fake agent]
    loader --> host
    host ~~~ runner ~~~ board ~~~ events ~~~ clock ~~~ guards ~~~ kit
  end

  subgraph ORCH[Coordinator - always on, required]
    orchestration[orchestration<br/>coordinator, max agents]
    agents[project agents<br/>one per project with a chat]
    orchestration ~~~ agents
  end

  subgraph CONV[Conversation and timers]
    session[session<br/>compact 08 13 18<br/>fresh 23, restart]
    schedule[schedule<br/>actions and jobs]
    session ~~~ schedule
  end

  subgraph RES[Machines, models, resources and disk]
    machines[machines<br/>labels: os, arch, tools<br/>places each job]
    models[models<br/>providers on other machines<br/>ordered model list per role]
    resources[resources<br/>caps per job and feature<br/>jobs from free resources<br/>disk floor per machine]
    docker[docker<br/>labels what a job creates<br/>removed with its worktree<br/>build cache cap, sweep]
    machines ~~~ models ~~~ resources ~~~ docker
  end

  subgraph PROJ[Projects, trackers, delivery, commits]
    projects[projects<br/>declared in the config]
    nvm[nvm<br/>Node version per project]
    findings[findings<br/>findings.md, on merge]
    youtrack[youtrack]
    github[github<br/>polls CI and PRs<br/>arthur github: PR reads]
    delivery[delivery<br/>review, merge]
    commit[commit-rules<br/>regex, words, file]
    projects ~~~ nvm ~~~ findings ~~~ youtrack ~~~ github ~~~ delivery ~~~ commit
  end

  subgraph SELF[Arthur itself]
    manage[manage<br/>audit, retro, health]
    develop[develop<br/>plugin new, evals]
    manage ~~~ develop
  end

  subgraph REACH[For clients]
    server[server<br/>private network only]
  end

  config[/arthur.config.ts/] --> loader
  env[/.env: secret values/] --> loader

  human <-->|messages| CH
  CH <-->|typed parts, text, media| host
  MEDIA <-->|claims voice, audio and video parts, text back| host
  video -->|asks listen.transcribe for a video's words| host
  host -->|listen.transcribe| listen
  ORCH <-->|events, commands| host
  CONV <-->|events, commands| host
  RES <-->|events, commands| host
  PROJ <-->|events, commands| host
  SELF <-->|events, commands| host
  REACH <-->|events, commands| host
  runner -->|spawns| omp[omp agent<br/>in a worktree]
  runner -->|SSH, private network| remote[other machines<br/>e.g. a Mac<br/>omp in a worktree]
  github -.->|polls| gh[(GitHub)]

  classDef first fill:#d8f5d8,stroke:#2d7a2d,color:#000;
  classDef later fill:#eee,stroke:#888,stroke-dasharray:4 3,color:#555;
  class terminal,telegram,discord,orchestration,session,schedule,machines,models,resources,docker,delivery,projects,nvm,findings,youtrack,github,commit,manage,develop,listen,video first;
  class whatsapp,signal,slack,agents,server later;
