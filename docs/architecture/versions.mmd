%% From the harness in use today to Arthur's first version and after it. Green = first version, grey dashed = later.
flowchart TD
  today[The harness in use today<br/>takes only fixes]
  move[Move modules with their tests<br/>core first, then plugins]

  subgraph V1[First version]
    core[core<br/>with job state and jobs over SSH]
    p1[orchestration - always on,<br/>machines, models, resources,<br/>session, schedule,<br/>projects, youtrack, telegram]
    p2[delivery, github,<br/>commit-rules, voice]
    p3[manage, develop,<br/>docker]
    core ~~~ p1 ~~~ p2 ~~~ p3
  end

  start[Arthur starts with an empty board<br/>the old history is not carried over]
  switch1[Switch one project first<br/>Arthur itself]
  switch2[Switch the other projects]

  subgraph V2[Later, in this order]
    agents[1 project agents<br/>one per project with a chat]
    signal[2 signal]
    discord[3 discord]
    slack[4 slack]
    whatsapp[5 whatsapp bridge]
    server[6 server and clients<br/>private network only]
    agents --> signal --> discord --> slack --> whatsapp --> server
  end

  today --> move --> V1 --> start --> switch1 --> switch2 --> V2

  classDef first fill:#d8f5d8,stroke:#2d7a2d,color:#000;
  classDef later fill:#eee,stroke:#888,stroke-dasharray:4 3,color:#555;
  class core,p1,p2,p3 first;
  class agents,signal,discord,slack,whatsapp,server later;
